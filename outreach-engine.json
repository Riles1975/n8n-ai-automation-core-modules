    {
      "parameters": {
        "jsCode": "const p = $json;\nconst company = p.company || 'your business';\nconst contactName = p.contactName || 'there';\nconst painPoint = p.painPoint || 'slow lead follow-up';\nconst offer = p.offer || 'AI automation';\n\nreturn [{\n  json: {\n    ...p,\n    subject: `Quick idea for ${company}`,\n    emailBody: `Hi ${contactName},\\n\\nI noticed ${company} may benefit from reducing ${painPoint}.\\n\\nI build simple ${offer} workflows that capture, qualify, and follow up with leads automatically, so fewer opportunities slip through the cracks.\\n\\nWorth a quick 15-minute conversation this week?\\n\\nAlex`,\n    outreachStatus: 'OUTREACH_DRAFT_READY'\n  }\n}];"
      },
      "id": "68abcd26-1f0f-40b3-936e-bdfe554a883e",
      "name": "Draft Outreach Message",
      "type": "n8n-nodes-base.code",
