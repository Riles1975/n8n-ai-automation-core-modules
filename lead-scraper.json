      "parameters": {
        "jsCode": "return [{\n  json: {\n    searchQuery: \"Roofing Companies\",\n    industry: \"Roofing\",\n    location: \"Austin, TX\",\n    targetRole: \"Owner\",\n    maxLeads: 25,\n    leadSource: \"Google Maps\",\n    saveDestination: \"Google Sheets\"\n  }\n}];"
      },
      "id": "ede77549-a84f-4e43-8255-f50a0a891a95",
      "name": "Prospect Source Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $input.first().json;\n\nconst leads = [\n  {\n    companyName: \"Austin Premier Roofing\",\n    contactName: \"Unknown Owner\",\n    title: config.targetRole,\n    website: \"https://example.com\",\n    email: \"info@example.com\",\n    phone: \"555-555-5555\",\n    location: config.location,\n    industry: config.industry,\n    leadSource: config.leadSource,\n    status: \"New Lead\"\n  },\n  {\n    companyName: \"Lone Star Roof Pros\",\n    contactName: \"Unknown Owner\",\n    title: config.targetRole,\n    website: \"https://example.com\",\n    email: \"contact@example.com\",\n    phone: \"555-555-5556\",\n    location: config.location,\n    industry: config.industry,\n    leadSource: config.leadSource,\n    status: \"New Lead\"\n  },\n  {\n    companyName: \"Capital City Roofing Co.\",\n    contactName: \"Unknown Owner\",\n    title: config.targetRole,\n    website: \"https://example.com\",\n    email: \"hello@example.com\",\n    phone: \"555-555-5557\",\n    location: config.location,\n    industry: config.industry,\n    leadSource: config.leadSource,\n    status: \"New Lead\"\n  }\n];\n\nreturn leads.map(lead => ({\n  json: {\n    ...lead,\n    dateAdded: new Date().toISOString()\n  }\n}));"
      },
      "id": "4f4a4afd-7c02-4b2c-b95c-b06e8c7bd93c",
